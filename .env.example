# ============================================
# SUNUCU YAPILANDIRMASI
# ============================================

# Sunucu Portu (varsayılan: 5001)
PORT=5001

# Sunucu Ortamı (development, production)
NODE_ENV=development

# ============================================
# VERİTABANI YAPILANDIRMASI
# ============================================

# MySQL Sunucusu Adresi
DB_HOST=localhost

# MySQL Kullanıcı Adı
DB_USER=root

# MySQL Şifresi
DB_PASSWORD=your_password_here

# Kullanılacak Veritabanı Adı
DB_NAME=yesim_tekstil

# MySQL Bağlantı Portu (varsayılan: 3306)
DB_PORT=3306

# Bağlantı Havuzu Ayarları
DB_CONNECTION_LIMIT=10

# ============================================
# JWT (JSON Web Token) YAPILANDIRMASI
# ============================================

# JWT Gizli Anahtarı (Şifreli token'lar imzalamak için)
# Örnek: openssl rand -hex 32
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# JWT Token Geçerlilik Süresi
# Formatlar: 2d, 24h, 60m, 3600s
JWT_EXPIRATION=7d

# ============================================
# E-POSTA YAPILANDIRMASI (Opsiyonel)
# ============================================

# SMTP Sunucu
SMTP_HOST=smtp.gmail.com

# SMTP Portu
SMTP_PORT=587

# E-posta Adresi
SMTP_EMAIL=your_email@gmail.com

# E-posta Şifresi veya App Password
SMTP_PASSWORD=your_app_password

# ============================================
# GÜVENLİK YAPILANDIRMASI
# ============================================

# CORS (Cross-Origin Resource Sharing) Ayarı
# Hangi kaynaklardan gelen isteklere izin verileceği
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# API Rate Limiting (İstek Sınırı)
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# LOGGING YAPILANDIRMASI
# ============================================

# Log Seviyesi (error, warn, info, debug)
LOG_LEVEL=info

# Log Dosya Yolu
LOG_FILE_PATH=./logs/app.log

# ============================================
# ÜRETİM MOD YAPIŞL (Production Only)
# ============================================

# CloudFlare DNS
CLOUDFLARE_API_KEY=your_cloudflare_api_key

# AWS S3 Buckets (Dosya Yüklemeleri için)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=your_bucket_name
AWS_S3_REGION=us-east-1

# ============================================
# ANALYTICS (Opsiyonel)
# ============================================

# Google Analytics
GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X

# Sentry Error Tracking
SENTRY_DSN=https://your_sentry_dsn@sentry.io/xxx

# ============================================
# API DOKÜMANTASYON
# ============================================

# Swagger/OpenAPI Aktifleştir
SWAGGER_ENABLED=true

# API Versiyonu
API_VERSION=v1

# ============================================
# TERCİH AYARLARI
# ============================================

# Dil (tr: Türkçe, en: İngilizce)
LANGUAGE=tr

# Zaman Dilimi
TIMEZONE=Europe/Istanbul

# Tarih Formatı (DD/MM/YYYY, MM/DD/YYYY, vb.)
DATE_FORMAT=DD/MM/YYYY

# Para Birimi
CURRENCY=TRY

# ============================================
# AÇIKLAMALAR
# ============================================

# NOT 1: Bu dosya ŞABLON DOSYASIDIR (.env.example)
# Gerçek .env dosyasını aşağıdaki şekilde oluştur:
# 
# Linux/Mac:
#   $ cp .env.example .env
#
# Windows PowerShell:
#   > Copy-Item .env.example .env
#
# Sonra .env dosyasını düzenle ve kendi bilgilerini gir.

# NOT 2: .env dosyası GİT'e YÜKLENMEMELİDİR
# .gitignore dosyasında aşağıdaki satırın olduğundan emin ol:
#   .env
#   .env.local
#   .env.*.local

# NOT 3: Üretim ortamında (Production):
# - Tüm gizli anahtarları değiştir
# - NODE_ENV=production olarak ayarla
# - HTTPS kullan
# - Güvenli bir şifre yöneticisi kullan

# NOT 4: JWT_SECRET oluştur (Linux/Mac):
# openssl rand -hex 32

# NOT 5: Database'i ilk kez oluşturuyorsan:
# 1. MySQL'de veritabanını oluştur:
#    CREATE DATABASE yesim_tekstil;
# 2. SQL schema dosyasını çalıştır:
#    mysql -u root -p yesim_tekstil < db/schema.sql
